# Copiez ce fichier en ".env" et ajustez les valeurs pour la production.

ENVIRONMENT=development

# --- Base de données ---
# SQLite par défaut (dev local sans Docker). En Docker, docker-compose.yml
# surcharge automatiquement cette valeur avec l'URL PostgreSQL du service `db`.
DATABASE_URL=sqlite:///./hcompany.db

# --- Redis (rate limiting) ---
# Laissez vide en dev local sans Docker : bascule automatique sur un stockage
# en mémoire. En Docker, surchargé automatiquement par docker-compose.yml.
REDIS_URL=

# --- JWT ---
# ⚠️ DOIT être identique à SECRET_KEY dans auth/.env — sinon les jetons
# émis par le service d'authentification commune ne seront jamais reconnus
# ici. Générez une vraie valeur en production (et reportez-la des deux
# côtés) :
# python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=dev-shared-secret-change-in-production-CHANGEME
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- Service d'authentification commune ---
# Appelé uniquement pour inscription/connexion/OTP — le reste du temps,
# les jetons sont vérifiés localement sans appel réseau.
# Valeur ci-dessous valable en dev SANS Docker (les deux backends tournent
# nativement sur la même machine). EN DOCKER, docker-compose.yml surcharge
# automatiquement cette valeur avec http://host.docker.internal:8003,
# puisque auth/ tourne dans un projet Docker Compose séparé — "localhost"
# depuis l'intérieur d'un conteneur ne pointe jamais sur la machine hôte.
AUTH_SERVICE_URL=http://localhost:8003
# ⚠️ DOIT être identique à SERVICE_API_KEY dans auth/.env — utilisée pour
# synchroniser le mot de passe généré d'un partenaire à son approbation.
AUTH_SERVICE_API_KEY=change-this-service-key-in-production

# --- Cookies ---
# COOKIE_SECURE=true est OBLIGATOIRE en production (HTTPS uniquement).
COOKIE_SECURE=false
COOKIE_DOMAIN=

# --- CORS ---
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173

# --- OTP ---
OTP_LENGTH=6
OTP_EXPIRE_MINUTES=10
OTP_MAX_ATTEMPTS=5

# --- Email (SMTP) — laissez vide en dev : les OTP/e-mails sont simulés dans les logs ---
#
# Pour envoyer de VRAIS e-mails en production, il faut un compte chez un
# fournisseur SMTP. Aucun de ces identifiants ne peut être créé pour vous —
# ce sont des comptes personnels/professionnels à créer vous-même. Options
# courantes, de la plus simple à la plus robuste pour du volume :
#
# 1. Gmail (dépannage rapide, limite ~500 e-mails/jour) :
#    SMTP_HOST=smtp.gmail.com, SMTP_PORT=587
#    SMTP_USER=votre-adresse@gmail.com
#    SMTP_PASSWORD=un "mot de passe d'application" généré sur
#      myaccount.google.com/apppasswords (PAS votre mot de passe Gmail
#      normal — Google bloque les mots de passe classiques pour ça)
#
# 2. SendGrid / Mailgun / Postmark (recommandé en vraie production —
#    meilleure délivrabilité, tableaux de bord, pas de limite Gmail) :
#    Créez un compte, générez une clé API SMTP depuis leur interface,
#    SMTP_USER est généralement "apikey" (SendGrid) ou votre identifiant de
#    domaine (Mailgun/Postmark), SMTP_PASSWORD est la clé fournie.
#
# Une fois configuré, vérifiez avec :
#   docker compose logs api | grep "simulé"
# Si cette ligne n'apparaît plus lors d'un envoi (inscription, OTP...),
# les e-mails partent réellement.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@h-company.africa

# --- WhatsApp (Twilio) — laissez vide en dev : les OTP WhatsApp sont simulés dans les logs ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# --- Supervision des erreurs (Sentry) — laissez vide en dev, aucun effet
# sans valeur. Créez un projet gratuit sur sentry.io (type "FastAPI") pour
# obtenir ce DSN.
SENTRY_DSN=
